# Copy this file to .env and fill in real values, then run:
#   docker compose up -d --build
# .env is gitignored — never commit real secrets.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=laundry66

# --- Backend ---
# Generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRE=7d
# Public URL of the frontend, used for backend CORS in production.
FRONTEND_URL=http://localhost

# --- Frontend ---
# Host port the site is served on (http://localhost:HTTP_PORT).
HTTP_PORT=80
